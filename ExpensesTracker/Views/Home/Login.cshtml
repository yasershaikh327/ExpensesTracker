<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>FinTrack — Login</title>
  <link rel="stylesheet" href="~/css/public.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <style>
    body { display: flex; flex-direction: column; min-height: 100vh; }
    .auth-wrapper {
      flex: 1; display: flex; align-items: center; justify-content: center;
      padding: 40px 20px;
    }
    .auth-outer { width: 100%; max-width: 440px; }

    /* Floating background grid dots */
    .bg-grid {
      position: fixed; inset: 0; z-index: 0;
      background-image:
        radial-gradient(circle, rgba(139,124,248,0.06) 1px, transparent 1px);
      background-size: 36px 36px;
      pointer-events: none;
    }
    .bg-glow {
      position: fixed; top: -100px; left: 50%; transform: translateX(-50%);
      width: 700px; height: 500px;
      background: radial-gradient(ellipse, rgba(139,124,248,0.08) 0%, transparent 65%);
      pointer-events: none; z-index: 0;
    }
    .auth-outer { position: relative; z-index: 1; }

    /* Password toggle */
    .pw-wrap { position: relative; }
    .pw-wrap .form-input { padding-right: 44px; }
    .pw-toggle {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: var(--text-muted); font-size: 14px; padding: 4px;
      transition: color 0.15s;
    }
    .pw-toggle:hover { color: var(--text-secondary); }

    /* Divider */
    .or-row {
      display: flex; align-items: center; gap: 12px;
      margin: 18px 0; color: var(--text-muted);
      font-size: 11px; font-family: var(--font-mono);
    }
    .or-row::before, .or-row::after { content:''; flex:1; height:1px; background:var(--border); }
  </style>
</head>
<body>

<div class="bg-grid"></div>
<div class="bg-glow"></div>

<nav class="topnav" style="position:relative;z-index:10;">
  <a href="Index" class="nav-logo">
    <div class="nav-logo-mark">₹</div>
    <div class="nav-logo-text">FinTrack</div>
  </a>
  <div class="nav-links">
        <a asp-action="Index" asp-controller="Home" class="nav-link active">Home</a>
        <a asp-action="About" asp-controller="Home" class="nav-link">About</a>
        <a asp-action="Contact" asp-controller="Home" class="nav-link">Contact</a>
        <a asp-action="Login" asp-controller="Home" class="nav-link">Login</a>
        <a asp-action="Registration" asp-controller="Home" class="nav-link cta">Get Started</a>
  </div>
  <button class="nav-toggle" onclick="toggleMobileMenu()" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="mobile-menu" id="mobileMenu" style="position:relative;z-index:10;">
    <a asp-action="Index" asp-controller="Home" class="nav-link active">Home</a>
    <a asp-action="About" asp-controller="Home" class="nav-link">About</a>
    <a asp-action="Contact" asp-controller="Home" class="nav-link">Contact</a>
    <a asp-action="Login" asp-controller="Home" class="nav-link">Login</a>
    <a asp-action="Registration" asp-controller="Home" class="nav-link cta">Get Started</a>
</div>

<div class="auth-wrapper">
  <div class="auth-outer">
    <div class="auth-card">

      <!-- Logo -->
      <div class="auth-logo">
        <div class="auth-logo-mark">₹</div>
        <div class="auth-title">Welcome back</div>
        <div class="auth-sub">Sign in to your FinTrack account</div>
      </div>

      <!-- Alerts -->
      <div class="alert error" id="loginError"></div>
      <div class="alert success" id="loginSuccess"></div>

      <!-- Form -->
      <div class="form-group">
        <label>Email address</label>
        <div class="input-icon-wrap">
          <svg class="input-icon" viewBox="0 0 16 16" fill="none">
            <rect x="1" y="3" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.2"/>
            <path d="M1 5.5l7 4.5 7-4.5" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          <input class="form-input" id="lEmail" type="email" placeholder="arjun@example.com"
            onkeydown="if(event.key==='Enter')loginSubmit()" />
        </div>
      </div>

      <div class="form-group">
        <label>
          Password
          <a href="#" style="float:right;font-size:11px;color:var(--purple);text-decoration:none;font-weight:500;text-transform:none;letter-spacing:0;" onclick="showForgot(event)">Forgot password?</a>
        </label>
        <div class="pw-wrap">
          <input class="form-input" id="lPassword" type="password" placeholder="••••••••"
            onkeydown="if(event.key==='Enter')loginSubmit()" />
          <button class="pw-toggle" onclick="togglePw('lPassword',this)" type="button">👁</button>
        </div>
      </div>


      <button class="btn btn-primary btn-full" onclick="loginSubmit()" id="loginBtn">
        Sign in →
      </button>

      <div class="or-row">or</div>

      <a href="Registration" class="btn btn-ghost btn-full" style="justify-content:center;display:flex;">
        Register now — it's free
      </a>

      <div class="auth-footer">
        Don't have an account?
        <a href="Registration">Create one →</a>
      </div>
    </div>

    <!-- Back to home -->
    <div style="text-align:center;margin-top:20px;">
      <a href="Index" style="font-size:12px;color:var(--text-muted);text-decoration:none;font-family:var(--font-mono);">← Back to home</a>
    </div>
  </div>
</div>

<script>
  function toggleMobileMenu(){document.getElementById('mobileMenu').classList.toggle('open');}

  function togglePw(id, btn) {
    const el = document.getElementById(id);
    el.type = el.type === 'password' ? 'text' : 'password';
    btn.textContent = el.type === 'password' ? '👁' : '🙈';
  }

  function showForgot(e) {
    e.preventDefault();
    alert('Password reset: check your email for a reset link.\n(Demo — no email is actually sent)');
  }

  function loginSubmit() {
    const email = document.getElementById('lEmail').value.trim();
    const pw    = document.getElementById('lPassword').value;
    const errEl = document.getElementById('loginError');
    const sucEl = document.getElementById('loginSuccess');
    errEl.classList.remove('show'); sucEl.classList.remove('show');

    if (!email || !pw) {
      errEl.textContent = '✗ Please enter your email and password.';
      errEl.classList.add('show'); return;
    }
    if (!email.includes('@@')) {
      errEl.textContent = '✗ Please enter a valid email address.';
      errEl.classList.add('show'); return;
    }
    if (pw.length < 6) {
      errEl.textContent = '✗ Password must be at least 6 characters.';
      errEl.classList.add('show'); return;
    }

    const btn = document.getElementById('loginBtn');
    btn.textContent = 'Signing in...'; btn.disabled = true;

  
  setTimeout(() => {
      const login = {  Email: email,Password: pw };
      $.ajax({
          url: "/Home/Login",
          method: "POST",
          contentType: "application/json",
          data: JSON.stringify(login),
          success: function(response) {
              sessionStorage.setItem('ft_user', JSON.stringify(login));
              if(response.message!=null){
                  sucEl.textContent = response.message;
                  sucEl.classList.add('show');
                  document.cookie = "jwtToken=" + response.token + "; path=/; max-age=86400; SameSite=Lax";
                  setTimeout(() => { window.location.href = '/Member/Index'; }, 3500);
              }
              else{
                errEl.textContent = '✗ User Not Found.';
                errEl.classList.add('show');
                setTimeout(() => { window.location.href = '/Home/Login'; }, 1000);
              }
          },
          error: function(error) {
              errEl.textContent = '✗ An error occurred during login.';
              errEl.classList.add('show');
              btn.textContent = 'Login'; btn.disabled = false;
          }
      });
    }, 900);
  }
</script>
</body>
</html>