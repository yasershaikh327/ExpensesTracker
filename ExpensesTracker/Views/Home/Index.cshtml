<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>FinTrack — Take Control of Your Money</title>
  <link rel="stylesheet" href="~/css/public.css" />
  <script src="~/js/site.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <style>
    /* ── Hero ── */
    .hero {
      text-align: center;
      padding: 90px 20px 80px;
      position: relative;
    }
    .hero-glow {
      position: absolute; top: -60px; left: 50%; transform: translateX(-50%);
      width: 600px; height: 400px;
      background: radial-gradient(ellipse at center, rgba(139,124,248,0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--purple-glow); border: 1px solid var(--purple-dim);
      color: var(--purple); border-radius: 20px;
      padding: 5px 14px; font-size: 11px; font-family: var(--font-mono);
      letter-spacing: 0.05em; margin-bottom: 28px;
    }
    .hero-badge span { width: 6px; height: 6px; border-radius: 50%; background: var(--purple); display: inline-block; }
    .hero-title {
      font-size: clamp(36px, 7vw, 72px); font-weight: 800;
      letter-spacing: -0.04em; line-height: 1.0; margin-bottom: 22px;
    }
    .hero-title .line2 { color: var(--purple); }
    .hero-desc {
      font-size: 17px; color: var(--text-secondary); max-width: 500px;
      margin: 0 auto 36px; line-height: 1.7;
    }
    .hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .hero-stats {
      display: flex; justify-content: center; gap: 48px;
      margin-top: 64px; flex-wrap: wrap;
    }
    .hero-stat-val { font-family: var(--font-mono); font-size: 28px; font-weight: 500; }
    .hero-stat-val.purple { color: var(--purple); }
    .hero-stat-val.teal   { color: var(--teal); }
    .hero-stat-val.amber  { color: var(--amber); }
    .hero-stat-lbl { font-size: 11px; color: var(--text-muted); margin-top: 2px; text-transform: uppercase; letter-spacing: 0.1em; }

    /* ── Feature cards ── */
    .features-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 16px; margin-top: 48px;
    }
    .feature-card { text-decoration: none; }
    .feat-icon {
      width: 44px; height: 44px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; margin-bottom: 16px;
    }
    .feat-title { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
    .feat-desc  { font-size: 13px; color: var(--text-secondary); line-height: 1.6; }

    /* ── How it works ── */
    .steps { display: flex; flex-direction: column; gap: 0; margin-top: 40px; }
    .step {
      display: grid; grid-template-columns: 56px 1fr;
      gap: 20px; padding-bottom: 36px; position: relative;
    }
    .step:not(:last-child)::after {
      content: ''; position: absolute;
      left: 27px; top: 52px; bottom: 0; width: 1px;
      background: var(--border);
    }
    .step-num {
      width: 56px; height: 56px; border-radius: 50%;
      background: var(--bg-raised); border: 1px solid var(--border-hi);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono); font-size: 16px; font-weight: 500;
      color: var(--purple); flex-shrink: 0;
    }
    .step-title { font-size: 15px; font-weight: 700; margin-bottom: 6px; margin-top: 14px; }
    .step-desc  { font-size: 13px; color: var(--text-secondary); line-height: 1.6; }

    /* ── CTA strip ── */
    .cta-strip {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius-xl); padding: 56px 48px;
      text-align: center; position: relative; overflow: hidden;
      margin-top: 80px;
    }
    .cta-strip::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--purple) 40%, var(--teal) 60%, transparent);
    }
    .cta-glow {
      position: absolute; bottom: -60px; left: 50%; transform: translateX(-50%);
      width: 500px; height: 300px;
      background: radial-gradient(ellipse, rgba(52,217,165,0.08) 0%, transparent 70%);
      pointer-events: none;
    }

    
  </style>
</head>
<body>

<!-- ── Nav ── -->
<nav class="topnav">
  <a asp-action="Index" asp-controller="Home" class="nav-logo">
    <div class="nav-logo-mark">₹</div>
    <div class="nav-logo-text">FinTrack</div>
  </a>
  <div class="nav-links">
    <a asp-action="Index" asp-controller="Home" class="nav-link active">Home</a>
    <a asp-action="About" asp-controller="Home" class="nav-link">About</a>
    <a asp-action="Contact" asp-controller="Home" class="nav-link">Contact</a>
    <a asp-action="Login" asp-controller="Home" class="nav-link">Login</a>
    <a asp-action="Registration" asp-controller="Home" class="nav-link cta">Get Started</a>
  </div>
  <button class="nav-toggle" onclick="toggleMobileMenu()" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="mobile-menu" id="mobileMenu">
    <a asp-action="Index" asp-controller="Home" class="nav-link active">Home</a>
    <a asp-action="About" asp-controller="Home" class="nav-link">About</a>
    <a asp-action="Contact" asp-controller="Home" class="nav-link">Contact</a>
    <a asp-action="Login" asp-controller="Home" class="nav-link">Login</a>
    <a asp-action="Registration" asp-controller="Home" class="nav-link cta">Get Started</a>
</div>

<!-- ── Hero ── -->
<div class="page" style="padding-top:0;padding-bottom:0;">
  <div class="hero">
    <div class="hero-glow"></div>
    <div class="hero-badge"><span></span> Personal Finance Tracker</div>
    <h1 class="hero-title">
      Know where your<br/>
      <span class="line2">money goes.</span>
    </h1>
    <p class="hero-desc">
      FinTrack gives you a real-time view of every rupee — what you spend, what you earn, and what you save. No spreadsheets, no guesswork.
    </p>
    <div class="hero-cta">
      <a asp-action="Registration" asp-controller="Home" class="btn btn-primary btn-lg">Start tracking free →</a>
      <a asp-action="About" asp-controller="Home"    class="btn btn-ghost btn-lg">Learn more</a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="hero-stat-val purple">₹0 hidden</div>
        <div class="hero-stat-lbl">Full transparency</div>
      </div>
      <div>
        <div class="hero-stat-val teal" id="totalViews"></div>
        <div class="hero-stat-lbl">Dashboard, TX, Budget, Reports</div>
      </div>
      <div>
        <div class="hero-stat-val amber">100% local</div>
        <div class="hero-stat-lbl">Your data stays yours</div>
      </div>
    </div>
  </div>
</div>

<!-- ── Features ── -->
<div class="page" style="padding-top:16px;">
  <div class="section-eyebrow">Features</div>
  <h2 class="section-title">Everything you need,<br/>nothing you don't.</h2>
  <p class="section-sub">Built for daily use — fast to enter, clear to read, and satisfying to track.</p>

  <div class="features-grid">
    <div class="card card-accent" style="--accent:var(--purple);">
      <div class="feat-icon" style="background:rgba(139,124,248,0.15);">📊</div>
      <div class="feat-title">Live Dashboard</div>
      <div class="feat-desc">See your total spent, income, and savings at a glance — with a 7-day trend chart and category donut updated in real time.</div>
    </div>
    <div class="card card-accent teal">
      <div class="feat-icon" style="background:rgba(52,217,165,0.15);">📋</div>
      <div class="feat-title">Transaction Log</div>
      <div class="feat-desc">Log expenses and income in seconds. Filter by type or category, search by keyword, and delete anything with one tap.</div>
    </div>
    <div class="card card-accent amber">
      <div class="feat-icon" style="background:rgba(245,185,66,0.15);">🎯</div>
      <div class="feat-title">Budget Tracking</div>
      <div class="feat-desc">Set monthly limits per category. Color-coded progress bars warn you before you overspend — and you can edit limits any time.</div>
    </div>
    <div class="card card-accent coral">
      <div class="feat-icon" style="background:rgba(240,112,96,0.15);">📈</div>
      <div class="feat-title">Monthly Reports</div>
      <div class="feat-desc">Category bar charts, top-5 biggest transactions, 14-day area chart, and a full percentage breakdown — all auto-generated.</div>
    </div>
    <div class="card card-accent" style="--accent:var(--teal);">
      <div class="feat-icon" style="background:rgba(96,184,240,0.15);">📱</div>
      <div class="feat-title">Mobile Friendly</div>
      <div class="feat-desc">Bottom tab bar on mobile, slide-in drawer, and a sheet-style add modal. Works perfectly on any screen size.</div>
    </div>
    <div class="card card-accent" style="--accent:var(--amber);">
      <div class="feat-icon" style="background:rgba(224,111,255,0.15);">🔒</div>
      <div class="feat-title">Private by Default</div>
      <div class="feat-desc">All your data lives in your browser session. Nothing is uploaded, synced, or stored on any server without your knowledge.</div>
    </div>
  </div>

  <div class="divider"></div>

  <!-- How it works -->
  <div class="section-eyebrow">How it works</div>
  <h2 class="section-title">Up and running<br/>in 3 steps.</h2>
  <div class="steps">
    <div class="step">
      <div class="step-num">01</div>
      <div>
        <div class="step-title">Create your account</div>
        <div class="step-desc">Register with your name, email, and a secure password. No credit card, no subscription — free to start.</div>
      </div>
    </div>
    <div class="step">
      <div class="step-num">02</div>
      <div>
        <div class="step-title">Log your first transaction</div>
        <div class="step-desc">Hit "+ Add" from any page. Enter a description, amount, category, and date. Takes under 10 seconds.</div>
      </div>
    </div>
    <div class="step">
      <div class="step-num">03</div>
      <div>
        <div class="step-title">Watch your finances come alive</div>
        <div class="step-desc">Your dashboard, charts, and budget bars update instantly. Check your Reports page at the end of the month for the full picture.</div>
      </div>
    </div>
  </div>

  <!-- CTA strip -->
  <div class="cta-strip">
    <div class="cta-glow"></div>
    <div class="section-eyebrow" style="text-align:center;margin-bottom:16px;">Ready?</div>
    <h2 class="section-title" style="font-size:clamp(24px,4vw,40px);margin-bottom:14px;">Start tracking today.</h2>
    <p style="color:var(--text-secondary);margin-bottom:32px;font-size:15px;">It takes 30 seconds to register. Your first transaction takes 10.</p>
    <a href="Home/Registration" class="btn btn-primary btn-lg">Create free account →</a>
  </div>
</div>

<!-- ── Footer ── -->
<footer class="site-footer">
  <div class="footer-copy">© 2026 FinTrack · dark pro v2.1</div>
  <div class="footer-links">
    <a asp-action="Index" asp-controller="Home">Home</a>
    <a asp-action="About" asp-controller="Home">About</a>
    <a asp-action="Contact" asp-controller="Home">Contact</a>
    <a asp-action="Login" asp-controller="Home">Login</a>
  </div>
</footer>

<script>
function toggleMobileMenu() {
  document.getElementById('mobileMenu').classList.toggle('open');
}
$.ajax({
          url: "/Home/CountViews",
          method: "POST",
          contentType: "application/json",
          data: JSON.stringify(contact),
          success: function(response) {
              if(response.success){
                  document.getElementById('totalViews').textContent = response.totalViews + " VUpdtdeiews";
              }else{
                  document.getElementById('errorAlert').classList.add('show');
                  document.getElementById('errorAlert').textContent = response.message;
              }
             
          },
          error: function(error) {
              errEl.textContent = '✗ An error occurred during contacting.';
              errEl.classList.add('show');
              btn.textContent = 'Send Message'; btn.disabled = false;
          }
      });
</script>
</body>
</html>