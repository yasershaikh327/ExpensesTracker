<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>FinTrack — Reset Password</title>
  <link rel="stylesheet" href="~/css/public.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <style>
    body { display: flex; flex-direction: column; min-height: 100vh; }
    .auth-wrapper {
      flex: 1; display: flex; align-items: center; justify-content: center;
      padding: 40px 20px;
    }
    .auth-outer { width: 100%; max-width: 440px; }

    /* Floating background grid dots */
    .bg-grid {
      position: fixed; inset: 0; z-index: 0;
      background-image:
        radial-gradient(circle, rgba(139,124,248,0.06) 1px, transparent 1px);
      background-size: 36px 36px;
      pointer-events: none;
    }
    .bg-glow {
      position: fixed; top: -100px; left: 50%; transform: translateX(-50%);
      width: 700px; height: 500px;
      background: radial-gradient(ellipse, rgba(139,124,248,0.08) 0%, transparent 65%);
      pointer-events: none; z-index: 0;
    }
    .auth-outer { position: relative; z-index: 1; }

    /* Password toggle */
    .pw-wrap { position: relative; }
    .pw-wrap .form-input { padding-right: 44px; }
    .pw-toggle {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: var(--text-muted); font-size: 14px; padding: 4px;
      transition: color 0.15s;
    }
    .pw-toggle:hover { color: var(--text-secondary); }

    /* Divider */
    .or-row {
      display: flex; align-items: center; gap: 12px;
      margin: 18px 0; color: var(--text-muted);
      font-size: 11px; font-family: var(--font-mono);
    }
    .or-row::before, .or-row::after { content:''; flex:1; height:1px; background:var(--border); }
  </style>
</head>
<body>

<div class="bg-grid"></div>
<div class="bg-glow"></div>

<nav class="topnav" style="position:relative;z-index:10;">
  <a href="Index" class="nav-logo">
    <div class="nav-logo-mark">₹</div>
    <div class="nav-logo-text">FinTrack</div>
  </a>
  <div class="nav-links">
        <a asp-action="Index" asp-controller="Home" class="nav-link active">Home</a>
        <a asp-action="About" asp-controller="Home" class="nav-link">About</a>
        <a asp-action="Contact" asp-controller="Home" class="nav-link">Contact</a>
        <a asp-action="Login" asp-controller="Home" class="nav-link">Login</a>
        <a asp-action="Registration" asp-controller="Home" class="nav-link cta">Get Started</a>
  </div>
  <button class="nav-toggle" onclick="toggleMobileMenu()" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="mobile-menu" id="mobileMenu" style="position:relative;z-index:10;">
    <a asp-action="Index" asp-controller="Home" class="nav-link active">Home</a>
    <a asp-action="About" asp-controller="Home" class="nav-link">About</a>
    <a asp-action="Contact" asp-controller="Home" class="nav-link">Contact</a>
    <a asp-action="Login" asp-controller="Home" class="nav-link">Login</a>
    <a asp-action="Registration" asp-controller="Home" class="nav-link cta">Get Started</a>
</div>

<div class="auth-wrapper">
  <div class="auth-outer">
    <div class="auth-card">

      <!-- Logo -->
      <div class="auth-logo">
        <div class="auth-logo-mark">₹</div>
        <div class="auth-title">Welcome back</div>
        <div class="auth-sub">Sign in to your FinTrack account</div>
      </div>

      <!-- Alerts -->
      <div class="alert error" id="loginError"></div>
      <div class="alert success" id="loginSuccess"></div>

      <!-- Form -->
      <!-- Old Password -->
        <div class="form-group">
          <label>Old Password <span style="color:var(--coral)">*</span></label>
          <div class="pw-wrap">
            <input class="form-input" id="lOldPassword" type="password" placeholder="Enter old password" />
            <button class="pw-toggle" onclick="togglePw('lOldPassword',this)" type="button">👁</button>
          </div>
          <div class="form-hint" id="oldPasswordHint"></div>
        </div>

        <!-- New Password -->
        <div class="form-group">
          <label>New Password <span style="color:var(--coral)">*</span></label>
          <div class="pw-wrap">
            <input class="form-input" id="lNewPassword" type="password" placeholder="Min. 8 characters"/>
            <button class="pw-toggle" onclick="togglePw('lNewPassword',this)" type="button">👁</button>
          </div>
          <div class="pw-strength">
            <div class="pw-strength-bar">
              <div class="pw-strength-fill" id="strengthFill"></div>
            </div>
          </div>
        </div>

        <!-- Confirm Password -->
        <div class="form-group">
          <label>Confirm Password <span style="color:var(--coral)">*</span></label>
          <div class="pw-wrap">
            <input class="form-input" id="lConfirmPassword" type="password" placeholder="Re-enter new password"/>
            <button class="pw-toggle" onclick="togglePw('lConfirmPassword',this)" type="button">👁</button>
          </div>
          <div class="form-hint" id="matchHint"></div>
        </div>

      <button class="btn btn-primary btn-full" onclick="ResetPassword();" id="loginBtn">
        Submit →
      </button>
    </div>

    <!-- Back to home -->
    <div style="text-align:center;margin-top:20px;">
      <a href="Login" style="font-size:12px;color:var(--text-muted);text-decoration:none;font-family:var(--font-mono);">← Back to home</a>
    </div>
  </div>
</div>

<script>
  function toggleMobileMenu(){document.getElementById('mobileMenu').classList.toggle('open');}

  function togglePw(id, btn) {
    const el = document.getElementById(id);
    el.type = el.type === 'password' ? 'text' : 'password';
    btn.textContent = el.type === 'password' ? '👁' : '🙈';
  }

  function ResetPassword() {
    const oldpassword = document.getElementById('lOldPassword').value.trim();
    const newpassword = document.getElementById('lNewPassword').value.trim();
    const confirmpassword = document.getElementById('lConfirmPassword').value.trim();
    const errEl = document.getElementById('loginError');
    const sucEl = document.getElementById('loginSuccess');
    const params = new URLSearchParams(window.location.search);
    const email = params.get("Email");
    const code = params.get("Code");

    errEl.classList.remove('show'); sucEl.classList.remove('show');

    if (!email ) {
      errEl.textContent = '✗ Please enter your email.';
      errEl.classList.add('show'); return;
    }

    if (!code ) {
      errEl.textContent = '✗ Please enter your code.';
      errEl.classList.add('show'); return;
    }

    if (!oldpassword ) {
      errEl.textContent = '✗ Please enter your old password.';
      errEl.classList.add('show'); return;
    }

    if (!newpassword ) {
      errEl.textContent = '✗ Please enter your new password.';
      errEl.classList.add('show'); return;
    }

    if (newpassword !== confirmpassword) {
      errEl.textContent = '✗ New password and confirm password do not match.';
      errEl.classList.add('show'); return;
    }


  
    const resetPassword = {  OldPassword: oldpassword, NewPassword: newpassword, ConfirmPassword: confirmpassword,Email:email, Code: code };
    $.ajax({
        url: "/Home/ResetPassword",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(resetPassword),
        success: function(response) {
            if(response.success){
                sucEl.textContent = response.message;
                sucEl.classList.add('show');
                setTimeout(() => { window.location.href = '/Home/Login'; }, 3500);
            }
            else{
                errEl.textContent = response.message;
                errEl.classList.add('show');
                setTimeout(() => { location.reload(); }, 3500);
            }
        },
        error: function(error) {
            errEl.textContent = '✗ An error occurred during password reset.';
            errEl.classList.add('show');
            btn.textContent = 'Reset Password'; btn.disabled = false;
        }
    });
  }
</script>
</body>
</html>