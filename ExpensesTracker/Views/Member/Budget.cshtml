<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FinTrack — Budget</title>
  <link rel="stylesheet" href="~/css/site.css" />
  <script src="~/js/site.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    .budget-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .budget-card {
      background: var(--bg-raised); border: 1px solid var(--border);
      border-radius: var(--radius-lg); padding: 18px 20px;
      transition: border-color 0.2s;
    }
    .budget-card:hover { border-color: var(--border-hi); }
    .budget-card-top { display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:14px; }
    .budget-cat-name { font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px; }
    .budget-cat-icon { width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px; }
    .budget-pct-badge { font-family:var(--font-mono);font-size:11px;padding:3px 10px;border-radius:20px;font-weight:500; }
    .bbar-bg { height:6px;background:var(--bg-deep);border-radius:3px;overflow:hidden; }
    .bbar-fill { height:6px;border-radius:3px;transition:width 0.6s cubic-bezier(0.4,0,0.2,1); }
    .budget-remaining { margin-top:10px;font-size:10px;font-family:var(--font-mono);color:var(--text-secondary); }
    .overview-strip { display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px; }
    
  </style>
</head>
<body>
<div class="shell">
  <div id="sidebar-mount"></div>
  <main class="main">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:12px;">
        <button class="menu-toggle" onclick="openDrawer()" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
        <div>
          <div class="page-title">Budget</div>
          <div class="month-badge" id="monthBadge"></div>
        </div>
      </div>
      <button class="add-btn" onclick="openModal()">+ Add</button>
    </div>

    <div class="overview-strip">
      <div class="stat-card c-amber">
        <div class="stat-label">Total Budget</div>
        <div class="stat-value amber" id="totalBudget">₹0</div>
        <div class="stat-change">all categories</div>
      </div>
      <div class="stat-card c-coral">
        <div class="stat-label">Total Spent</div>
        <div class="stat-value coral" id="totalSpent">₹0</div>
        <div class="stat-change" id="spentPct"></div>
      </div>
      <div class="stat-card c-teal">
        <div class="stat-label">Remaining</div>
        <div class="stat-value" id="totalRemaining">₹0</div>
        <div class="stat-change" id="remainingDays"></div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">Category Budgets</div>
      </div>
      <div class="budget-grid" id="budgetGrid"></div>
    </div>
  </main>
  <div id="mobile-nav-mount"></div>
  <div id="modal-mount"></div>
</div>


<script>
  document.getElementById('sidebar-mount').innerHTML    = renderSidebar('budget');
  document.getElementById('mobile-nav-mount').innerHTML = renderMobileNav('budget');
  document.getElementById('modal-mount').innerHTML      = renderModal();

  const now = new Date();
  document.getElementById('monthBadge').textContent =
    now.toLocaleDateString('en-IN',{month:'long',year:'numeric'}).toUpperCase();

  let entries = loadEntries();
  let budgets = (()=>{try{return JSON.parse(sessionStorage.getItem('ft_budgets'))||{...BUDGET_LIMITS};}catch{return{...BUDGET_LIMITS};}})();
  const saveBudgets=()=>sessionStorage.setItem('ft_budgets',JSON.stringify(budgets));
  const getExpenses=()=>entries.filter(e=>e.type==='expense');
  const getCatSpend=()=>{const c={};getExpenses().forEach(e=>{c[e.cat]=(c[e.cat]||0)+e.amt;});return c;};

  function updateOverview(catSpend){
    // const totalBudget=Object.values(budgets).reduce((s,v)=>s+v,0);
    // const totalSpent=Object.entries(catSpend).filter(([c])=>budgets[c]!==undefined).reduce((s,[,v])=>s+v,0);
    // const remaining=Math.max(totalBudget-totalSpent,0);
    // const pct=Math.round(totalSpent/totalBudget*100);
    // document.getElementById('totalBudget').textContent=fmt_inr(totalBudget);
    // document.getElementById('totalSpent').textContent=fmt_inr(totalSpent);
    // document.getElementById('totalRemaining').textContent=fmt_inr(remaining);
    // document.getElementById('spentPct').innerHTML=`<span class="${pct>80?'down':'up'}">${pct}% of budget</span>`;
    // const daysLeft=new Date(now.getFullYear(),now.getMonth()+1,0).getDate()-now.getDate();
    // document.getElementById('remainingDays').innerHTML=`<span class="up">${daysLeft} days left</span>`;
     $.ajax({
        url: "/Member/GetDashboardData",
        method: "GET",
        success: function(response) {
            const remaining = response.data.totalIncome - response.data.totalSpent;
            document.getElementById('totalSpent').textContent   = fmt_inr(response.data.totalSpent);
            document.getElementById('totalBudget').textContent  = fmt_inr(response.data.totalIncome);
            const totalRemaining = document.getElementById('totalRemaining');
            if (response.data.netSaving >= 0) {
                totalRemaining.style.color = "green";
            } else {
                totalRemaining.style.color = "red";
            }
            document.getElementById('totalRemaining').textContent = fmt_inr(response.data.netSaving);
        },
        error: function(error) {
           alert('✗ An error occurred during contacting.');
           return false;
        }
    });
  }

  function renderBudget() {
  const grid = document.getElementById('budgetGrid');
  if (!grid) return;

  $.ajax({
    url: "/Member/GetDashboardData",
    method: "GET",
    success: function (response) {
      const budgets = response?.data?.budget ?? [];

      if (!budgets.length) {
        grid.innerHTML = `<div class="empty-state">no budget data</div>`;
        return;
      }

      updateOverview(
        budgets.reduce((acc, e) => {
          acc[e.category] = Number(e.amount || 0);
          return acc;
        }, {})
      );

      grid.innerHTML = budgets.map(e => {
        const category = (e.category != "Other") ? e.category : e.otherCategory;
        const amount = Number(e.amount ?? 0);
        const meta = CAT_META[category] || CAT_META.Other;

        return `
          <div class="budget-card">
            <div class="budget-card-top">
              <div class="budget-cat-name">
                <div class="budget-cat-icon" style="background:${meta.color}22;">${meta.icon}</div>
                ${category}
              </div>
            </div>

            <div style="margin-bottom:10px;">
              <div style="font-family:var(--font-mono);font-size:20px;font-weight:500;color:${meta.color};">
                ${fmt_inr(amount)}
              </div>
            </div>
          </div>
        `;
      }).join('');
    },
    error: function () {
      grid.innerHTML = `<div class="empty-state">failed to load budget</div>`;
    }
  });
}

  function editLimit(cat){
    const val=prompt(`Budget for ${cat} (current: ₹${budgets[cat].toLocaleString('en-IN')}):`,budgets[cat]);
    if (val===null) return;
    const num=parseFloat(val);
    if (!num||num<=0){alert('Enter a valid amount.');return;}
    budgets[cat]=num; saveBudgets(); renderBudget();
  }

function saveEntry() {
    const btn = document.querySelector('.type-btn.active-neg, .type-btn.active-pos');
    const type = btn?.id === 'btnExpense' ? 'expense' : 'income';
    const desc=document.getElementById('fDesc').value.trim();
    const amt=parseFloat(document.getElementById('fAmt').value);
    const cat=document.getElementById('fCat').value;
    const date=document.getElementById('fDate').value;
    const othercat=document.getElementById('othercatinput').value;
    if(cat === 'Other' && othercat === ''){
        alert('Please fill Other Category Input Field.');return;
    }
    if (!desc||!amt||amt<=0||!date){alert('Please fill all fields.');return;}
    // entries.push({id:getNextId(entries),type:_entryType,desc,cat,amt,date});
    // saveEntries(entries);
    // document.getElementById('fDesc').value='';
    // document.getElementById('fAmt').value='';
    const expense = { ExpenseType :type, Description: desc, Amount: amt, Category: cat, DateofExpense: date,OtherCatInput: othercat };
      $.ajax({
          url: "/Member/Expense",
          method: "POST",
          contentType: "application/json",
          data: JSON.stringify(expense),
          success: function(response) {
              if(response.success) {
                  Swal.fire({
                  text: response.message,
                  icon: "success",
                  theme: 'dark'
                });
               setTimeout(function () {
                    location.reload();
                }, 1500);
              }else{
                 Swal.fire({
                  text: "✗ Failed to save the entry.",
                  icon: "error",
                  theme: 'dark'
                });
                 return false;
              }
            
          },
          error: function(error) {
             alert('✗ An error occurred during contacting.');
             return false;
          }
      });

    closeModal(); renderAll();
  }

  window.addEventListener('load', renderBudget);
</script>
</body>
</html>