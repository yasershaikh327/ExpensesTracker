<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FinTrack — Reports</title>
  <link rel="stylesheet" href="~/css/site.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="~/js/site.js"></script>
  <style>
    .report-grid { display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px; }
    .chart-wrap  { position:relative; }
    canvas       { width:100%;height:100%;display:block; }
    .top-table   { width:100%;border-collapse:collapse; }
    .top-table th { font-size:9px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);padding:8px 12px;text-align:left;border-bottom:1px solid var(--border); }
    .top-table td { padding:10px 12px;font-size:13px;border-bottom:1px solid var(--border); }
    .top-table tr:last-child td { border-bottom:none; }
    .top-table tr:hover td { background:var(--bg-raised); }
    .rank-badge { width:22px;height:22px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;font-family:var(--font-mono); }
  
  </style>
</head>
<body>
<div class="shell">
  <div id="sidebar-mount"></div>
  <main class="main">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:12px;">
        <button class="menu-toggle" onclick="openDrawer()" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
        <div>
          <div class="page-title">Reports</div>
          <div class="month-badge" id="monthBadge"></div>
        </div>
      </div>
      <button class="add-btn" onclick="openModal()">+ Add</button>
    </div>

    <div class="stats-grid" style="margin-bottom:24px;">
      <div class="stat-card">
        <div class="stat-label">Avg Daily Spend</div>
        <div class="stat-value purple" id="avgDaily">₹0</div>
        <div class="stat-change">this month</div>
      </div>
      <div class="stat-card c-amber">
        <div class="stat-label">Biggest Expense</div>
        <div class="stat-value amber" id="biggestExp">₹0</div>
        <div class="stat-change" id="biggestExpDesc">—</div>
      </div>
      <div class="stat-card c-teal">
        <div class="stat-label">Transactions</div>
        <div class="stat-value teal" id="txCount">0</div>
        <div class="stat-change">this month</div>
      </div>
    </div>

    <div class="report-grid">
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title">Spending by category</div>
        </div>
        <div class="chart-wrap" style="height:220px;"><canvas id="barChart"></canvas></div>
      </div>
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title">Top transactions</div>
          <div class="panel-sub">by amount</div>
        </div>
        <table class="top-table" id="topTable"></table>
      </div>
    </div>

    <div class="panel" style="margin-bottom:14px;">
      <div class="panel-header">
        <div class="panel-title">Daily spending — last 14 days</div>
      </div>
      <div class="chart-wrap" style="height:200px;"><canvas id="areaChart"></canvas></div>
    </div>

    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">Category breakdown</div>
        <div class="panel-sub">% of total spend</div>
      </div>
      <div id="catBreakdown" style="display:flex;flex-direction:column;gap:12px;margin-top:4px;"></div>
    </div>
  </main>
  <div id="mobile-nav-mount"></div>
  <div id="modal-mount"></div>
</div>


<script>
  document.getElementById('sidebar-mount').innerHTML    = renderSidebar('reports');
  document.getElementById('mobile-nav-mount').innerHTML = renderMobileNav('reports');
  document.getElementById('modal-mount').innerHTML      = renderModal();

  const now = new Date();
  document.getElementById('monthBadge').textContent =
    now.toLocaleDateString('en-IN',{month:'long',year:'numeric'}).toUpperCase();

  let entries = loadEntries();
  const getExpenses=()=>entries.filter(e=>e.type==='expense');

function updateStats() {
  $.ajax({
    url: "/Member/GetDashboardData",
    method: "GET",
    success: function (response) {
      const tx = response?.data?.transaction ?? [];
      const days = new Date().getDate();

      const expenses = tx.filter(e => (e.type ?? '').toUpperCase() === 'D');

      const totalSpent = expenses.reduce((s, e) => s + Number(e.amount || 0), 0);

      document.getElementById('avgDaily').textContent =
        fmt_inr(days > 0 ? Math.round(totalSpent / days) : 0);

      document.getElementById('txCount').textContent = expenses.length;

      if (expenses.length) {
        const top = expenses.reduce((m, e) =>
          Number(e.amount || 0) > Number(m.amount || 0) ? e : m
        , expenses[0]);

        document.getElementById('biggestExp').textContent =
          fmt_inr(Number(top.amount || 0));

        document.getElementById('biggestExpDesc').textContent =
          top.description ?? 'null';
      } else {
        document.getElementById('biggestExp').textContent = '₹0';
        document.getElementById('biggestExpDesc').textContent = 'null';
      }
    },
    error: function () {
      document.getElementById('avgDaily').textContent = '₹0';
      document.getElementById('txCount').textContent = '0';
      document.getElementById('biggestExp').textContent = '₹0';
      document.getElementById('biggestExpDesc').textContent = 'null';
    }
  });
}

  function drawBarChart() {
  const canvas = document.getElementById('barChart');
  if (!canvas) return;

  $.ajax({
    url: "/Member/GetDashboardData",
    method: "GET",
    success: function (response) {
      const tx = response?.data?.transaction ?? [];

      const dpr = window.devicePixelRatio || 1;
      const W = canvas.offsetWidth, H = canvas.offsetHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;

      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      const cats = {};
      tx.forEach(e => {
        if ((e.type ?? '').toUpperCase() !== 'D') return;

        const cat = e.category ?? null;
        const amt = Number(e.amount || 0);

        if (!cat) return;
        cats[cat] = (cats[cat] || 0) + amt;
      });

      const data = Object.entries(cats).sort((a, b) => b[1] - a[1]);
      if (!data.length) return;

      const maxV = Math.max(...data.map(d => d[1]), 1);
      const pad = { t: 20, r: 10, b: 44, l: 55 };
      const cW = W - pad.l - pad.r;
      const cH = H - pad.t - pad.b;
      const gap = cW / data.length;
      const bW = gap * 0.55;

      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = '#2a2a27';
      ctx.lineWidth = 0.5;

      [0, .25, .5, .75, 1].forEach(f => {
        const y = pad.t + cH * (1 - f);
        ctx.beginPath();
        ctx.moveTo(pad.l, y);
        ctx.lineTo(W - pad.r, y);
        ctx.stroke();

        ctx.fillStyle = '#444440';
        ctx.font = '9px JetBrains Mono,monospace';
        ctx.textAlign = 'right';
        ctx.fillText('₹' + (maxV * f / 1000).toFixed(0) + 'k', pad.l - 6, y + 4);
      });

      data.forEach(([cat, val], i) => {
        const x = pad.l + i * gap + (gap - bW) / 2;
        const bH = (val / maxV) * cH;
        const y = pad.t + cH - bH;

        const meta = CAT_META[cat] || CAT_META.Other;

        ctx.fillStyle = meta.color + 'bb';
        ctx.beginPath();
        ctx.roundRect(x, y, bW, bH, 4);
        ctx.fill();

        ctx.fillStyle = '#888880';
        ctx.font = '9px JetBrains Mono,monospace';
        ctx.textAlign = 'center';
        ctx.fillText(meta.icon, x + bW / 2, H - 18);
        ctx.fillText(cat, x + bW / 2, H - 6);

        ctx.fillStyle = meta.color;
        ctx.font = 'bold 9px JetBrains Mono,monospace';
        ctx.fillText('₹' + (val / 1000).toFixed(1) + 'k', x + bW / 2, y - 6);
      });
    }
  });
}

function drawAreaChart() {
  const canvas = document.getElementById('areaChart');
  if (!canvas) return;

  $.ajax({
    url: "/Member/GetDashboardData",
    method: "GET",
    success: function (response) {
      const tx = response?.data?.transaction ?? [];

      const dpr = window.devicePixelRatio || 1;
      const W = canvas.offsetWidth, H = canvas.offsetHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;

      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      const days = [];

      for (let i = 13; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);

        const key = fmt(d);

        const sum = tx
          .filter(e => (e.type ?? '').toUpperCase() === 'D' && e.date === key)
          .reduce((s, e) => s + Number(e.amount || 0), 0);

        days.push({
          label: d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }),
          val: sum
        });
      }

      const maxV = Math.max(...days.map(d => d.val), 500);
      const pad = { t: 10, r: 10, b: 36, l: 50 };
      const cW = W - pad.l - pad.r;
      const cH = H - pad.t - pad.b;

      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = '#2a2a27';
      ctx.lineWidth = 0.5;

      [0, .5, 1].forEach(f => {
        const y = pad.t + cH * (1 - f);
        ctx.beginPath();
        ctx.moveTo(pad.l, y);
        ctx.lineTo(W - pad.r, y);
        ctx.stroke();

        ctx.fillStyle = '#444440';
        ctx.font = '9px JetBrains Mono,monospace';
        ctx.textAlign = 'right';
        ctx.fillText('₹' + (maxV * f / 1000).toFixed(0) + 'k', pad.l - 6, y + 4);
      });

      ctx.fillStyle = '#444440';
      ctx.font = '9px JetBrains Mono,monospace';
      ctx.textAlign = 'center';

      days.forEach((d, i) => {
        if (i % 2 === 0) {
          ctx.fillText(d.label, pad.l + i / (days.length - 1) * cW, H - 4);
        }
      });

      const pts = days.map((d, i) => ({
        x: pad.l + i / (days.length - 1) * cW,
        y: pad.t + cH * (1 - d.val / maxV)
      }));

      const grad = ctx.createLinearGradient(0, pad.t, 0, pad.t + cH);
      grad.addColorStop(0, 'rgba(52,217,165,0.25)');
      grad.addColorStop(1, 'rgba(52,217,165,0)');

      ctx.beginPath();
      ctx.moveTo(pts[0].x, pts[0].y);
      pts.slice(1).forEach(p => ctx.lineTo(p.x, p.y));
      ctx.lineTo(pts[pts.length - 1].x, pad.t + cH);
      ctx.lineTo(pts[0].x, pad.t + cH);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(pts[0].x, pts[0].y);
      pts.slice(1).forEach(p => ctx.lineTo(p.x, p.y));
      ctx.strokeStyle = '#00ff68';
      ctx.lineWidth = 2;
      ctx.lineJoin = 'round';
      ctx.stroke();

      pts.forEach(p => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);
        ctx.fillStyle = '#00ff68';
        ctx.fill();
        ctx.strokeStyle = '#0d0d0b';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      });
    }
  });
}

  function renderTopTable() {
  $.ajax({
    url: "/Member/GetDashboardData",
    method: "GET",
    success: function (response) {
      const tx = response?.data?.transaction ?? [];
      const top5 = tx
        .filter(e => (e.type ?? '').toUpperCase() === 'D')
        .sort((a, b) => Number(b.amount || 0) - Number(a.amount || 0))
        .slice(0, 5);

      const rankColors = ['#f5b942', '#888880', 'red', '#8b7cf8', '#00ff68'];

      document.getElementById('topTable').innerHTML = `
        <thead>
          <tr>
            <th>#</th>
            <th>Description</th>
            <th>Category</th>
            <th style="text-align:right">Amount</th>
          </tr>
        </thead>
        <tbody>
          ${top5.map((e, i) => {
            const meta = CAT_META[e.category] || CAT_META.Other;
            const category = (e.category != "Other") ? e.category : e.otherCategory;
            return `
              <tr>
                <td>
                  <span class="rank-badge" style="background:${rankColors[i]}22;color:${rankColors[i]};">
                    ${i + 1}
                  </span>
                </td>
                <td>${e.description ?? 'null'}</td>
                <td>
                  <span style="font-size:10px;font-family:var(--font-mono);color:${meta.color};">
                    ${meta.icon} ${category ?? 'null'}
                  </span>
                </td>
                <td style="text-align:right;font-family:var(--font-mono);color:var(--coral);">
                  ${fmt_inr(Number(e.amount || 0))}
                </td>
              </tr>
            `;
          }).join('')}
        </tbody>
      `;
    },
    error: function () {
      document.getElementById('topTable').innerHTML = `
        <thead>
          <tr>
            <th>#</th>
            <th>Description</th>
            <th>Category</th>
            <th style="text-align:right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <tr><td colspan="4" style="text-align:center;">failed to load</td></tr>
        </tbody>
      `;
    }
  });
}

function renderCatBreakdown() {
  $.ajax({
    url: "/Member/GetDashboardData",
    method: "GET",
    success: function (response) {
      const tx = response?.data?.transaction ?? [];
      const cats = {};

      tx.forEach(e => {
        if ((e.type ?? '').toUpperCase() !== 'D') return;

        const cat = e.category ?? null;
        const amt = Number(e.amount || 0);

        if (!cat) return;
        cats[cat] = (cats[cat] || 0) + amt;
      });

      const total = Object.values(cats).reduce((s, v) => s + v, 0);

      if (!total) {
        document.getElementById('catBreakdown').innerHTML = '';
        return;
      }

      document.getElementById('catBreakdown').innerHTML = Object.entries(cats)
        .sort((a, b) => b[1] - a[1])
        .map(([cat, val]) => {
          const pct = Math.round((val / total) * 100);
          const meta = CAT_META[cat] || CAT_META.Other;

          return `
            <div>
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                <div style="font-size:12px;font-weight:600;display:flex;align-items:center;gap:6px;">
                  ${meta.icon} ${cat}
                </div>
                <div style="display:flex;gap:16px;align-items:center;">
                  <span style="font-family:var(--font-mono);font-size:12px;color:var(--text-secondary);">
                    ${fmt_inr(val)}
                  </span>
                  <span style="font-family:var(--font-mono);font-size:12px;font-weight:500;color:${meta.color};">
                    ${pct}%
                  </span>
                </div>
              </div>
              <div style="height:5px;background:var(--bg-raised);border-radius:3px;">
                <div style="height:5px;width:${pct}%;background:${meta.color};border-radius:3px;transition:width 0.5s;"></div>
              </div>
            </div>
          `;
        }).join('');
    },
    error: function () {
      document.getElementById('catBreakdown').innerHTML = '';
    }
  });
}

function saveEntry() {
    const btn = document.querySelector('.type-btn.active-neg, .type-btn.active-pos');
    const type = btn?.id === 'btnExpense' ? 'expense' : 'income';
    const desc=document.getElementById('fDesc').value.trim();
    const amt=parseFloat(document.getElementById('fAmt').value);
    const cat=document.getElementById('fCat').value;
    const date=document.getElementById('fDate').value;
    const othercat=document.getElementById('othercatinput').value;
    if(cat === 'Other' && othercat === ''){
        alert('Please fill Other Category Input Field.');return;
    }
    if (!desc||!amt||amt<=0||!date){alert('Please fill all fields.');return;}
    // entries.push({id:getNextId(entries),type:_entryType,desc,cat,amt,date});
    // saveEntries(entries);
    // document.getElementById('fDesc').value='';
    // document.getElementById('fAmt').value='';
    const expense = { ExpenseType :type, Description: desc, Amount: amt, Category: cat, DateofExpense: date,OtherCatInput: othercat };
      $.ajax({
          url: "/Member/Expense",
          method: "POST",
          contentType: "application/json",
          data: JSON.stringify(expense),
          success: function(response) {
              if(response.success) {
                  Swal.fire({
                  text: response.message,
                  icon: "success",
                  theme: 'dark'
                });
               setTimeout(function () {
                    location.reload();
                }, 1500);
              }else{
                 Swal.fire({
                  text: "✗ Failed to save the entry.",
                  icon: "error",
                  theme: 'dark'
                });
                 return false;
              }
            
          },
          error: function(error) {
             alert('✗ An error occurred during contacting.');
             return false;
          }
      });

    closeModal(); renderAll();
  }

  function renderAll(){
    entries=loadEntries();
    updateStats(); drawBarChart(); drawAreaChart(); renderTopTable(); renderCatBreakdown();
  }
  window.addEventListener('load', renderAll);
  window.addEventListener('resize',()=>{drawBarChart();drawAreaChart();});
</script>
</body>
</html>