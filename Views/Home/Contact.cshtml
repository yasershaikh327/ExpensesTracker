<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>FinTrack — Contact Us</title>
  <link rel="stylesheet" href="~/css/public.css" />
  <style>
    .contact-grid { display: grid; grid-template-columns: 1fr 380px; gap: 32px; align-items: start; margin-top: 48px; }
    .contact-info { display: flex; flex-direction: column; gap: 20px; }
    .info-card { display: flex; gap: 14px; align-items: flex-start; }
    .info-icon {
      width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; font-size: 18px;
    }
    .info-label { font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); font-family: var(--font-mono); margin-bottom: 3px; }
    .info-val   { font-size: 14px; font-weight: 600; }
    .info-sub   { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }

    .rating-row { display: flex; gap: 8px; }
    .star-btn {
      background: var(--bg-deep); border: 1px solid var(--border-hi);
      border-radius: var(--radius-sm); padding: 8px 12px;
      font-size: 18px; cursor: pointer; transition: all 0.15s;
    }
    .star-btn:hover, .star-btn.active { background: rgba(245,185,66,0.15); border-color: #7a5410; }

    .char-count { font-size: 10px; font-family: var(--font-mono); color: var(--text-muted); text-align: right; margin-top: 4px; }

   
  </style>
</head>
<body>

<nav class="topnav">
  <a href="index.html" class="nav-logo">
    <div class="nav-logo-mark">₹</div>
    <div class="nav-logo-text">FinTrack</div>
  </a>
  <div class="nav-links">
     <a asp-action="Index" asp-controller="Home" class="nav-link active">Home</a>
    <a asp-action="About" asp-controller="Home" class="nav-link">About</a>
    <a asp-action="Contact" asp-controller="Home" class="nav-link">Contact</a>
    <a asp-action="Login" asp-controller="Home" class="nav-link">Login</a>
    <a asp-action="Registration" asp-controller="Home" class="nav-link cta">Get Started</a>
  </div>
  <button class="nav-toggle" onclick="toggleMobileMenu()" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="mobile-menu" id="mobileMenu">
    <a asp-action="Index" asp-controller="Home" class="nav-link active">Home</a>
    <a asp-action="About" asp-controller="Home" class="nav-link">About</a>
    <a asp-action="Contact" asp-controller="Home" class="nav-link">Contact</a>
    <a asp-action="Login" asp-controller="Home" class="nav-link">Login</a>
    <a asp-action="Registration" asp-controller="Home" class="nav-link cta">Get Started</a>
</div>

<div class="page-md" style="max-width:960px;">
  <div class="section-eyebrow">Contact Us</div>
  <h1 class="section-title">We'd love to hear<br/><span class="highlight">from you.</span></h1>
  <p class="section-sub">Have feedback, a bug to report, or just want to say hello? Fill in the form and we'll get back to you within 24 hours.</p>

  <div class="contact-grid">

    <!-- Left: Info cards -->
    <div class="contact-info">
      <div class="card info-card">
        <div class="info-icon" style="background:rgba(139,124,248,0.15);">✉️</div>
        <div>
          <div class="info-label">Email</div>
          <div class="info-val">hello@fintrack.app</div>
          <div class="info-sub">We reply within 24 hours on weekdays.</div>
        </div>
      </div>
      <div class="card info-card">
        <div class="info-icon" style="background:rgba(52,217,165,0.15);">💬</div>
        <div>
          <div class="info-label">Feedback type</div>
          <div class="info-val">Feature requests welcome</div>
          <div class="info-sub">We review every suggestion — many features came from user feedback.</div>
        </div>
      </div>
      <div class="card info-card">
        <div class="info-icon" style="background:rgba(245,185,66,0.15);">🐛</div>
        <div>
          <div class="info-label">Bug reports</div>
          <div class="info-val">Describe what went wrong</div>
          <div class="info-sub">Include your browser name and what you were trying to do.</div>
        </div>
      </div>
      <div class="card info-card">
        <div class="info-icon" style="background:rgba(240,112,96,0.15);">📍</div>
        <div>
          <div class="info-label">Based in</div>
          <div class="info-val">Goa, India</div>
          <div class="info-sub">UTC +5:30 · IST timezone</div>
        </div>
      </div>
    </div>

    <!-- Right: Form -->
    <div class="card" style="border-radius:var(--radius-xl);padding:32px;">
      <div id="successAlert" class="alert success">
        ✓ Message sent! We'll get back to you within 24 hours.
      </div>
      <div id="errorAlert" class="alert error">
        ✗ Please fill in all required fields.
      </div>

      <div class="form-group">
        <label>Your name <span style="color:var(--coral)">*</span></label>
        <input class="form-input" id="cName" type="text" placeholder="Arjun Kumar" />
      </div>
      <div class="form-group">
        <label>Email address <span style="color:var(--coral)">*</span></label>
        <input class="form-input" id="cEmail" type="email" placeholder="arjun@example.com" />
      </div>
      <div class="form-group">
        <label>Subject <span style="color:var(--coral)">*</span></label>
        <select class="form-input" id="cSubject">
          <option value="">Select a topic...</option>
          <option value="feedback">General feedback</option>
          <option value="bug">Bug report</option>
          <option value="feature">Feature request</option>
          <option value="question">Question</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="form-group">
        <label>How would you rate FinTrack?</label>
        <div class="rating-row" id="ratingRow">
          <button class="star-btn" data-val="1" onclick="setRating(1)">⭐</button>
          <button class="star-btn" data-val="2" onclick="setRating(2)">⭐</button>
          <button class="star-btn" data-val="3" onclick="setRating(3)">⭐</button>
          <button class="star-btn" data-val="4" onclick="setRating(4)">⭐</button>
          <button class="star-btn" data-val="5" onclick="setRating(5)">⭐</button>
        </div>
      </div>
      <div class="form-group">
        <label>Message <span style="color:var(--coral)">*</span></label>
        <textarea class="form-textarea" id="cMessage" placeholder="Tell us what's on your mind..." maxlength="1000" oninput="updateCount(this)"></textarea>
        <div class="char-count"><span id="charCount">0</span> / 1000</div>
      </div>

      <button class="btn btn-primary btn-full" onclick="submitForm()">Send message →</button>
      <p style="font-size:11px;color:var(--text-muted);text-align:center;margin-top:12px;font-family:var(--font-mono);">
        We never share your email with third parties.
      </p>
    </div>
  </div>
</div>

<footer class="site-footer">
  <div class="footer-copy">© 2026 FinTrack · dark pro v2.1</div>
  <div class="footer-links">
    <a href="index.html">Home</a>
    <a href="about.html">About</a>
    <a href="contact.html">Contact</a>
    <a href="login.html">Login</a>
  </div>
</footer>

<script>
  function toggleMobileMenu(){document.getElementById('mobileMenu').classList.toggle('open');}

  let rating = 0;
  function setRating(val) {
    rating = val;
    document.querySelectorAll('.star-btn').forEach((btn, i) => {
      btn.classList.toggle('active', i < val);
    });
  }

  function updateCount(el) {
    document.getElementById('charCount').textContent = el.value.length;
  }

  function submitForm() {
    const name    = document.getElementById('cName').value.trim();
    const email   = document.getElementById('cEmail').value.trim();
    const subject = document.getElementById('cSubject').value;
    const message = document.getElementById('cMessage').value.trim();

    document.getElementById('successAlert').classList.remove('show');
    document.getElementById('errorAlert').classList.remove('show');

    if (!name || !email || !subject || !message) {
      document.getElementById('errorAlert').classList.add('show');
      return;
    }

    // Simulate submission
    document.querySelector('#successAlert').classList.add('show');
    document.getElementById('cName').value    = '';
    document.getElementById('cEmail').value   = '';
    document.getElementById('cSubject').value = '';
    document.getElementById('cMessage').value = '';
    document.getElementById('charCount').textContent = '0';
    rating = 0;
    document.querySelectorAll('.star-btn').forEach(b => b.classList.remove('active'));
  }
</script>
</body>
</html>